# Copy to .env and fill in. .env is gitignored — never commit real tokens.
# Load with:  set -a; source .env; set +a
HF_TOKEN=hf_xxx
HUGGING_FACE_HUB_TOKEN=hf_xxx
GITHUB_TOKEN=ghp_xxx
GH_TOKEN=ghp_xxx
WANDB_API_KEY=
# 설명 사이트 배포(docs/site) — 없으면 wrangler 배포만 안 된다
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
# paper-banana(그림 생성) 스킬 — 없으면 그 스킬만 안 된다
GOOGLE_API_KEY=
